#!/bin/sh
# Wrapper that runs the SDK aapt2, under qemu-x86_64 on arm64 hosts.
#
# The override is configured repo-relative ("android.aapt2FromMavenOverride=tools/aapt2"
# in gradle.properties) so a fresh clone builds on any host without local edits.
# Resolve the project's declared Build Tools version, never the first installed SDK.
# AAPT2 34 rejects AGP 9 optimize flags while AGP can still report success.
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd)"

resolve_aapt2() {
    if [ -n "$AAPT2_REAL" ]; then
        [ -x "$AAPT2_REAL" ] && echo "$AAPT2_REAL"
        return
    fi
    build_tools_version="$(sed -n 's/^[[:space:]]*buildToolsVersion = "\([^"]*\)".*/\1/p' "$PROJECT_DIR/app/build.gradle.kts")"
    [ -n "$build_tools_version" ] || return
    sdk_dir="$ANDROID_HOME"
    if [ -z "$sdk_dir" ] && [ -f "$PROJECT_DIR/local.properties" ]; then
        sdk_dir="$(sed -n 's/^[[:space:]]*sdk\.dir[[:space:]]*=[[:space:]]*//p' "$PROJECT_DIR/local.properties" | head -n1)"
    fi
    candidate="$sdk_dir/build-tools/$build_tools_version/aapt2"
    [ -x "$candidate" ] && echo "$candidate"
}

AAPT2_BIN="$(resolve_aapt2)"
if [ -z "$AAPT2_BIN" ]; then
    echo "ERROR: cannot locate aapt2 for the project Build Tools version." >&2
    echo "  Set AAPT2_REAL or ANDROID_HOME, or add sdk.dir to local.properties." >&2
    exit 1
fi

case "$(uname -m)" in
    aarch64|arm64)
        if command -v qemu-x86_64 >/dev/null 2>&1; then
            exec qemu-x86_64 "$AAPT2_BIN" "$@"
        fi
        ;;
esac
exec "$AAPT2_BIN" "$@"
