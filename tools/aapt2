#!/bin/sh
# Wrapper that runs the SDK aapt2, under qemu-x86_64 on arm64 hosts.
#
# The override is configured repo-relative ("android.aapt2FromMavenOverride=tools/aapt2"
# in gradle.properties) so a fresh clone builds on any host without local edits.
# This script resolves the real aapt2 from, in priority order:
#   1. $AAPT2_REAL environment variable
#   2. $ANDROID_HOME/build-tools/<version>/aapt2
#   3. sdk.dir from local.properties (repo root), any build-tools version
# Fails with a clear message instead of a cryptic exec error.

SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"

resolve_aapt2() {
    if [ -n "$AAPT2_REAL" ] && [ -x "$AAPT2_REAL" ]; then
        echo "$AAPT2_REAL"
        return
    fi
    if [ -n "$ANDROID_HOME" ]; then
        for bt in "$ANDROID_HOME"/build-tools/*/aapt2; do
            [ -x "$bt" ] && echo "$bt" && return
        done
    fi
    for base in "$SCRIPT_DIR" "$SCRIPT_DIR/.."; do
        if [ -f "$base/local.properties" ]; then
            sdk_dir="$(sed -n 's/^[[:space:]]*sdk\.dir[[:space:]]*=[[:space:]]*//p' "$base/local.properties" | head -n1 | tr -d '[:space:]')"
            if [ -n "$sdk_dir" ]; then
                for bt in "$sdk_dir"/build-tools/*/aapt2; do
                    [ -x "$bt" ] && echo "$bt" && return
                done
            fi
        fi
    done
    echo ""
}

AAPT2_BIN="$(resolve_aapt2)"
if [ -z "$AAPT2_BIN" ]; then
    echo "ERROR: cannot locate SDK aapt2." >&2
    echo "  Set AAPT2_REAL or ANDROID_HOME, or add sdk.dir to local.properties." >&2
    exit 1
fi

case "$(uname -m)" in
    aarch64|arm64)
        if command -v qemu-x86_64 >/dev/null 2>&1; then
            exec qemu-x86_64 "$AAPT2_BIN" "$@"
        fi
        ;;
esac
exec "$AAPT2_BIN" "$@"
